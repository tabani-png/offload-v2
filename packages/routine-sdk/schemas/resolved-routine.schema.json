{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offload.consultance.ai/schemas/resolved-routine.json",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "schedule"
            },
            "cron": {
              "type": "string",
              "pattern": "^[0-9*/,-]+( [0-9*/,-]+){4}$"
            },
            "timezone": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(\\/[A-Za-z0-9_+-]+)*$"
            }
          },
          "required": [
            "kind",
            "cron"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "webhook"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "event"
            },
            "event_type": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
            }
          },
          "required": [
            "kind",
            "event_type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "manual"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "steps": {
      "minItems": 1,
      "maxItems": 64,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "args": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "foreach": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "class": {
                "type": "string",
                "const": "read"
              },
              "runs_on": {
                "type": "string",
                "const": "cloud"
              },
              "capability": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
              },
              "connection_ref": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "connection_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "adapter": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "account_label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "tool_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "tool_pin_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "args",
              "class",
              "runs_on",
              "capability",
              "connection_ref",
              "connection_id",
              "adapter",
              "provider",
              "account_label",
              "tool_name",
              "tool_pin_hash"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "args": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "foreach": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "class": {
                "type": "string",
                "const": "draft"
              },
              "runs_on": {
                "type": "string",
                "const": "cloud"
              },
              "capability": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
              },
              "connection_ref": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "connection_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "adapter": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "account_label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "tool_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "tool_pin_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "args",
              "class",
              "runs_on",
              "capability",
              "connection_ref",
              "connection_id",
              "adapter",
              "provider",
              "account_label",
              "tool_name",
              "tool_pin_hash"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "args": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "foreach": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "class": {
                "type": "string",
                "const": "commit"
              },
              "runs_on": {
                "type": "string",
                "const": "cloud"
              },
              "capability": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
              },
              "connection_ref": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "connection_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "adapter": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "account_label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "tool_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "tool_pin_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "args",
              "class",
              "runs_on",
              "capability",
              "connection_ref",
              "connection_id",
              "adapter",
              "provider",
              "account_label",
              "tool_name",
              "tool_pin_hash"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "args": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "foreach": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "class": {
                "type": "string",
                "const": "commit"
              },
              "runs_on": {
                "type": "string",
                "const": "device"
              },
              "capability": {
                "type": "string",
                "enum": [
                  "shortcut.run",
                  "appleevent.template",
                  "ax.action",
                  "browser.step"
                ]
              },
              "connection_ref": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "connection_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "adapter": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "account_label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "tool_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "tool_pin_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "args",
              "class",
              "runs_on",
              "capability",
              "connection_ref",
              "connection_id",
              "adapter",
              "provider",
              "account_label",
              "tool_name",
              "tool_pin_hash"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "args": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "foreach": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "class": {
                "type": "string",
                "const": "transform"
              },
              "runs_on": {
                "type": "string",
                "const": "cloud"
              },
              "transform": {
                "type": "string",
                "maxLength": 200,
                "pattern": "^transforms\\/[a-z0-9_-]+(\\/[a-z0-9_-]+)*\\.ts$"
              }
            },
            "required": [
              "id",
              "args",
              "class",
              "runs_on",
              "transform"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "args": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,64}$"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "foreach": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,31}$"
              },
              "class": {
                "type": "string",
                "const": "model"
              },
              "runs_on": {
                "type": "string",
                "const": "cloud"
              },
              "model": {
                "type": "object",
                "properties": {
                  "route": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,31}$"
                  },
                  "prompt_ref": {
                    "type": "string",
                    "maxLength": 200,
                    "pattern": "^prompts\\/[a-z0-9_-]+(\\/[a-z0-9_-]+)*\\.md$"
                  },
                  "output_schema_ref": {
                    "type": "string",
                    "maxLength": 200,
                    "pattern": "^schemas\\/[a-z0-9_-]+(\\/[a-z0-9_-]+)*\\.json$"
                  }
                },
                "required": [
                  "route",
                  "prompt_ref",
                  "output_schema_ref"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "args",
              "class",
              "runs_on",
              "model"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_items_per_run": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "max_runs_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 96
        },
        "run_budget_usd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4
        },
        "quiet_hours": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                }
              },
              "required": [
                "start",
                "end"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "recipients_from": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        }
      },
      "required": [
        "max_items_per_run",
        "max_runs_per_day",
        "run_budget_usd"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
      }
    }
  },
  "required": [
    "v",
    "name",
    "trigger",
    "steps",
    "limits",
    "capabilities"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^(?:[^{}]|\\{(?!\\{)|\\}(?!\\})|\\{\\{\\s*(?:steps\\.([a-z][a-z0-9_]{0,31})\\.output((?:\\/(?:[^~/{}\\s]|~[01])*)*)|item\\.([A-Za-z_][A-Za-z0-9_]{0,63}))\\s*\\}\\})*$"
        },
        {
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
