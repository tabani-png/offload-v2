{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offload.consultance.ai/schemas/connection-create.json",
  "type": "object",
  "properties": {
    "adapter": {
      "type": "string",
      "enum": [
        "mcp",
        "composio",
        "openapi",
        "browser"
      ]
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "personal": {
      "type": "boolean"
    },
    "api_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  },
  "required": [
    "adapter",
    "provider",
    "workspace_id",
    "personal"
  ],
  "additionalProperties": false
}
