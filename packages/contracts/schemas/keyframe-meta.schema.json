{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offload.consultance.ai/schemas/keyframe-meta.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "phash": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1280
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 524288
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "id",
    "ts",
    "phash",
    "width",
    "height",
    "bytes",
    "sha256"
  ],
  "additionalProperties": false
}
