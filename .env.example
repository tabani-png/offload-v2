# Offload v2 environment variables. Names only. Never commit values.
# Copy to .env for local development. .env is git-ignored. *_REF variables name a secret (KMS key id, secret manager
# entry or local file path); they never hold the secret itself.

# Postgres 17 (pgvector). The only required datastore.
DATABASE_URL=
# Used only by `offload migrate` (role offload_migrator). Empty means DATABASE_URL.
DATABASE_MIGRATOR_URL=
# Role used by services at runtime (no BYPASSRLS). See docs/adr/0013-tenancy-and-rls.md
DATABASE_APP_ROLE=

# Public origin of the API and web app (OIDC redirect URIs, links in mail). See docs/DEPLOYMENT.md
OFFLOAD_PUBLIC_BASE_URL=

# Object storage (S3-compatible). Empty means the local-disk adapter in dev.
OFFLOAD_OBJECT_STORE_URL=
OFFLOAD_OBJECT_STORE_BUCKET=
# Static keys for an S3-compatible store (self-host). Empty on Offload Cloud, which uses its workload role.
OFFLOAD_OBJECT_STORE_ACCESS_KEY_ID=
OFFLOAD_OBJECT_STORE_SECRET_ACCESS_KEY=

# Retention in days. Empty means the defaults pending docs/OPEN_QUESTIONS.md OQ-02
# (metadata 30, screen text 7, connector content 30).
OFFLOAD_RAW_TTL_DAYS=
OFFLOAD_TEXT_TTL_DAYS=
OFFLOAD_CONTENT_TTL_DAYS=

# Key management. See docs/adr/0034-credential-broker-and-key-providers.md
# aws-kms or gcp-kms: key id. local key provider (self-host): path to a 32-byte key file readable only by the broker.
OFFLOAD_KMS_KEY_REF=
OFFLOAD_MASTER_KEY_FILE=
# Signing keys (references). Device tokens are ES256: docs/adr/0014-identity.md
OFFLOAD_DEVICE_TOKEN_SIGNING_KEY_REF=
OFFLOAD_SERVICE_SIGNING_KEY_REF=
# Unix socket shared by offload serve and offload broker only. See docs/adr/0034-credential-broker-and-key-providers.md
OFFLOAD_BROKER_SOCKET=

# Model providers for the product's model router. See docs/adr/0021-model-router-and-builders.md
# Agents building this repo use Claude Code signed into the owner's subscription with this variable unset
# (AGENTS.md, model and tool usage). Set it only where the operator allows.
ANTHROPIC_API_KEY=
# Optional local tier (Ollama or exo, loopback or private network only).
OFFLOAD_LOCAL_MODEL_URL=

# Sandboxes. See docs/adr/0011-sandboxed-build-workers.md
OFFLOAD_SANDBOX_PROVIDER=
E2B_API_KEY=
# docker provider: the separate sandbox Docker daemon (compose profile "builds"), never the host's socket.
OFFLOAD_SANDBOX_DOCKER_HOST=

# Connectors. See docs/adr/0010-mcp-first-connectors.md
COMPOSIO_API_KEY=

# Identity. See docs/adr/0014-identity.md
OFFLOAD_OIDC_ISSUER=
OFFLOAD_OIDC_CLIENT_ID=
OFFLOAD_OIDC_CLIENT_SECRET_REF=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# Enterprise features. Empty means core only. One key, or one per plan separated by whitespace.
# Same mechanism on Offload Cloud and self-host. See docs/OPEN_CORE.md and docs/adr/0037-hosting-cloud-and-self-host-parity.md
OFFLOAD_EE_LICENSE_KEY=

# Telemetry from a self-host deploy: off or on. Empty means off. See docs/adr/0037-hosting-cloud-and-self-host-parity.md
OFFLOAD_TELEMETRY=

# docker compose only (infra/docker-compose/compose.yaml). Not read by Offload itself.
# Image placeholder until images are published; version tag of the release to run.
OFFLOAD_IMAGE=
OFFLOAD_VERSION=
# Host port for offload serve (bound to 127.0.0.1; put a TLS proxy in front).
OFFLOAD_HTTP_PORT=
# Bootstrap password of the Postgres container's offload_migrator role.
POSTGRES_PASSWORD=
# Root credentials of the bundled S3-compatible store container.
OBJECT_STORE_ROOT_USER=
OBJECT_STORE_ROOT_PASSWORD=
